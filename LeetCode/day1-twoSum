class Solution {
    public int[] twoSum(int[] nums, int target) {
        int res[] = new int[2];
        int sum = 0;
        int i =0, j = 0;
        for( i =0 ; i<nums.length ; i++){
            for(j = i ; j<nums.length-1 ;j++){
                sum = nums[i]+nums[j+1];
                if(sum == target){
                    res[0] = i;
                    res[1] = j +1;
                    break;
                }
            }
            if(sum == target){
                break;
            }
        }
    return res;
    }
    public static void main(String[] args){
        Solution obj = new Solution();
        int res1[] = new int[2];
        int nums[] = {2,5,5,11};
        res1 = obj.twoSum(nums,10);
        System.out.println("you can add these numbers to get the target " + nums[res1[0]] + " and " + nums[res1[1]]);
        for(int p = 0 ; p <2 ; p++){
            System.out.println(res1[p]);
        }
    }
}
