#Palindrome Number id:9

class Solution {
    public boolean isPalindrome(int x) {
        int num = x;
        int d;
        int rev=0;
        while(num>0){
            d = num%10;
            rev = rev*10 + d;
            num = num/10;

        }
    if(x == rev){
            return true;
        }
    else{
            return false;
        }
    }
    public static void main(String[] args){
        Solution obj = new Solution();
        boolean a = obj.isPalindrome(121);
        System.out.println(a);
    }
}
